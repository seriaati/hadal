node_modules/

# Settings for this machine only, such as HADAL_DEV_MODE
.env

# The bundled page the link preview is drawn from
design/brand/out/

# What the pack tools learn about each pack. The sources of the prompts that grow live in the database; a local copy
# is what tools/sources.ts reads, and fills an empty local database
curation/*.json

# The built-in packs live in the database. A copy here is what the pack tools work on, and fills an empty local database
/packs/
